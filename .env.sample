# Optional per-run overrides for start.sh.
#
# To use this file:  cp .env.sample .env   (the real .env is not tracked
# by git — this sample is what gets committed). Every variable below is
# optional; unset/removed values fall back to start.sh's own defaults.
#
# Precedence (highest first):
#   1. shell env vars already exported when you run ./start.sh
#   2. values in ./.env
#   3. start.sh inline defaults

# Image tag and container name.
#IMAGE=ghcr.io/niko1221/strata:0.2.19-rocm-gfx1151
#CONTAINER_NAME=hy4-flash-strata

# Host publish port (container always listens on 8080 internally, published
# on 127.0.0.1 only).
#PORT=8080

# Where the ~181 GB model files live / get downloaded to (bind-mounted at
# /data in the container). Use an absolute path if you change this.
#DATA_DIR=/home/you/strata-data

# Log file for the engine output stream.
#LOG_FILE=./.hy4.log

# Ready timeout (seconds). The first launch downloads ~181 GB (resumable
# across restarts), so the default is generous.
#READY_TIMEOUT=14400

# Model family and size. SQ-64 | SQ-96 | SQ-128 (default; needs 128 GiB RAM).
#FAMILY=hy4-flash
#MODEL=SQ-128

# Optional engine passthroughs — leave unset for the vendor defaults
# (128K context, vision on, DFly2 drafting). Do NOT set DRAFTING: the hy4
# family drafter set is off|dfly2 and the entrypoint's values are Qwen-only.
#CONTEXT=                                  # default 131072 (128K)
#VISION=                                   # on by default (Hy4-Flash-Vision.strata, 0.93 GB)
#KV=
#PARALLEL=
#TUNE=
#STRATA_SET=

# API key for the OpenAI endpoint. Unset (default) = no key at all: the server
# is published on 127.0.0.1 only, so nothing outside this machine can reach it.
# Set it to require "Authorization: Bearer <key>" on every /v1 request.
#API_KEY=
